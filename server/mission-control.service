[Unit]
Description=Personal OS Mission Control server (Tasks/Planner/Calendar/Shopping/Roadmap)
After=network.target

[Service]
Type=simple
# EDIT THESE TWO before installing — path to where you cloned the repo, and the
# Linux user that should own the process (a non-root user is fine and preferred).
WorkingDirectory=/home/<YOUR_USER>/personal-os/server
User=<YOUR_USER>

ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# Matches js/core/config.js's MC_TOKEN. If you ever regenerate this, update
# both places together — a mismatch fails silently (client queues forever,
# never actually lands on the server).
Environment=MC_PORT=4200
Environment=MC_TOKEN=f8d0db72f97ee2fccdf30b0c30db4980

[Install]
WantedBy=multi-user.target
